# Unsure if these are directories or files
function_calls
gmon.out

# Temporary files that are used during make format-src and make format-symbols respectively
format-src.run
format-symbols.run

# Matches in repo root folder only
/*.map
# /assets/

# ninja stuff
.ninja_lock
.ninja_log
.ninja_deps
build.ninja
build.ninja.version

# objdiff stuff
objdiff*.json

# rust
target/**

# in-game generated recording files
recordings/

# PC port: crash/debug logs and the packaged export folder (exportar.ps1).
# dist/ contains a copy of the Konami game assets, so it must never be committed.
*.log
/dist/
# written by the "Dump VRAM" debug menu action
/vram_dump.bin
/entities_dump.txt
# Generated by tools/saturn-splitter from config/saturn/*.yaml
/config/saturn/*.ld
/config/saturn/*.gen.txt
